###############################################################################
# Environment Configuration - CAG Estimator                                 ###
###############################################################################
#                                                                           ###
# API Keys:                                                                 ###
#   OPENAI_API_KEY: OpenAI API key for authentication                       ###
#   ANTHROPIC_API_KEY: Anthropic API key for authentication                 ###
#   At least one of them is required at startup : the app validates this    ###
#   and refuses to boot without one. OPENAI_API_KEY is additionally needed  ###
#   for the moderation guardrail and the semantic cache's embeddings; with  ###
#   no OpenAI key both disable themselves and log why.                      ###
#                                                                           ###
# Application Settings:                                                     ###
#   APP_ENV: development | staging | production                             ###
#   LOG_LEVEL: DEBUG | INFO | WARNING | ERROR                               ###
#                                                                           ###
# LiteLLM Wrapper (provider fallback):                                      ###
#   PRIMARY_MODEL: model tried first (e.g. gpt-4o-mini)                     ###
#   FALLBACK_MODEL: model used if the primary fails after retries           ###
#     (e.g. claude-haiku-4-5-20251001)                                      ###
#   LLM_TIMEOUT: per-call timeout in seconds                                ###
#   LLM_RETRIES: retry attempts on the primary model before falling back    ###
#                                                                           ###
# Prompts:                                                                  ###
#   PROMPT_VERSION: which template directory under                          ###
#     app/prompts/estimation/ is served. A deploy-time decision, never a    ###
#     client-supplied parameter. Every response echoes it back.             ###
#                                                                           ###
# Redis:                                                                    ###
#   REDIS_URL: connection string, e.g. redis://localhost:6379               ###
#     Inside docker-compose this is overridden to redis://redis:6379        ###
#     Must be Redis Stack (RediSearch) for the semantic cache to work.      ###
#   CACHE_TTL: seconds to keep an exact-match cached response               ###
#                                                                           ###
# Semantic Cache:                                                           ###
#   EMBEDDING_MODEL: model used to embed descriptions                       ###
#   SEMANTIC_CACHE_THRESHOLD: minimum cosine similarity to serve a hit      ###
#     (0.85 default; measured ~0.91 for a genuine paraphrase and ~0.00 for  ###
#     an unrelated description in the same bucket)                          ###
#   SEMANTIC_CACHE_TTL: seconds to keep a semantic cache entry              ###
#   SEMANTIC_CACHE_LOG_ONLY: when true, log would-be hits but never serve   ###
#     them : used to calibrate the threshold against real traffic first     ###
#                                                                           ###
# Streamlit Client:                                                         ###
#   ESTIMATOR_API_BASE_URL: base URL Streamlit uses to reach this API       ###
#                                                                           ###
# Sessions (multi-turn estimation):                                         ###
#   MAX_TURNS: sliding-window size, in (user, assistant) turns, for a       ###
#     session's conversation history. Sessions live in a process-local      ###
#     dict: no database, no Redis, so this and project_metadata are lost   ###
#     on restart; see app/sessions/models.py for why that's accepted here. ###
#   CONVERSATIONAL_PROMPT_VERSION: template version for the session         ###
#     endpoint (adds <project_metadata>), independent of PROMPT_VERSION.    ###
#   MAX_ATTACHMENT_WORDS: word-count cap per attachment. Over this it's     ###
#     reported as a failed attachment, not silently truncated.             ###
#   METADATA_EXTRACTOR_MODEL / METADATA_EXTRACTOR_FALLBACK_MODEL: dedicated ###
#     primary/fallback pair for the metadata-extraction side call,         ###
#     independent of PRIMARY_MODEL/FALLBACK_MODEL.                         ###
#   COMPRESSION_MODEL / COMPRESSION_FALLBACK_MODEL: dedicated primary/      ###
#     fallback pair for the compression side calls (cumulative summary,    ###
#     and the anchor classifier when ANCHOR_DETECTION_MODE=llm). Defaults  ###
#     to gpt-5-nano: cheaper than METADATA_EXTRACTOR_MODEL on both input    ###
#     and output for this lighter, higher-volume workload.                 ###
#   ANCHOR_DETECTION_MODE: heuristic | llm. heuristic (default) is a free  ###
#     regex match against a curated phrase list (EN+ES), no LLM call.      ###
#     llm classifies each evicted turn via Instructor instead, more        ###
#     robust to paraphrase at the cost of one extra call per eviction.     ###
#                                                                           ###
###############################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APP_ENV=development
LOG_LEVEL=DEBUG

PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30
LLM_RETRIES=2

PROMPT_VERSION=v1

REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOG_ONLY=false

ESTIMATOR_API_BASE_URL=http://localhost:8000

MAX_TURNS=6
CONVERSATIONAL_PROMPT_VERSION=v3
MAX_ATTACHMENT_WORDS=8000
METADATA_EXTRACTOR_MODEL=gpt-4o-mini
METADATA_EXTRACTOR_FALLBACK_MODEL=claude-haiku-4-5-20251001
COMPRESSION_MODEL=gpt-5-nano
COMPRESSION_FALLBACK_MODEL=claude-haiku-4-5-20251001
ANCHOR_DETECTION_MODE=heuristic
